  {
    "id": "json-extract",
    "name": "Structured extraction (JSON)",
    "type": "code",
    "difficulty": "hard",
    "version": 1,
    "system": "You output raw JSON and nothing else: no explanation, no markdown code fences, no text before or after the object.",
    "prompt": "From this note, output a JSON object with exactly the keys \"invoice\" (string), \"client\" (string) and \"total\" (number, the amount actually due). Note: 'Invoice 88-B for Nordwind GmbH. Three units of cable at 12.50 each, two units of adapter at 7.25 each, plus 9.00 of shipping. No VAT applies.'",
    "target_tokens": 256,
    "reference": "{\"invoice\": \"88-B\", \"client\": \"Nordwind GmbH\", \"total\": 61.00}",
    "checks": [
      {
        "kind": "regex",
        "pattern": "\"invoice\"\\s*:\\s*\"?88-b",
        "weight": 2,
        "label": "invoice = 88-B"
      },
      {
        "kind": "regex",
        "pattern": "\"client\"\\s*:\\s*\"nordwind",
        "weight": 2,
        "label": "client = Nordwind GmbH"
      },
      {
        "kind": "regex",
        "pattern": "\"total\"\\s*:\\s*\"?61(\\.0+)?\"?\\s*[,}\\n]",
        "weight": 3,
        "label": "total = 61.00 (line items + shipping)"
      },
      {
        "kind": "absent",
        "of": [
          "52",
          "52.00"
        ],
        "weight": 2,
        "label": "did not forget the shipping"
      },
      {
        "kind": "absent",
        "pattern": "```",
        "weight": 2,
        "label": "raw JSON, no markdown fences"
      }
    ]
  },
