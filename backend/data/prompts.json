  {
    "id": "code",
    "name": "Code generation",
    "type": "code",
    "difficulty": "medium",
    "version": 1,
    "system": "You are an expert programming assistant. Use ONLY the Python standard library (no external dependencies) and return the code inside a ```python block.",
    "prompt": "Implement a function `merge_intervals(intervals)` that takes a list of (start, end) tuples and returns the list of merged overlapping intervals, sorted by start. Use only the standard library. Example: merge_intervals([(1,3),(2,6),(8,10)]) -> [(1,6),(8,10)].",
    "target_tokens": 512,
    "reference": "Sort by start and merge while the current start <= the previous end.",
    "code_tests": [
      "assert [tuple(i) for i in merge_intervals([(1,3),(2,6),(8,10),(15,18)])] == [(1,6),(8,10),(15,18)]",
      "assert list(merge_intervals([])) == []",
      "assert [tuple(i) for i in merge_intervals([(1,4),(4,5)])] == [(1,5)]",
      "assert [tuple(i) for i in merge_intervals([(1,10),(2,3),(4,5)])] == [(1,10)]",
      "assert [tuple(i) for i in merge_intervals([(5,6),(1,2)])] == [(1,2),(5,6)]"
    ]
  },
  {
    "id": "code-hard",
    "name": "Code generation (edge cases)",
    "type": "code",
    "difficulty": "hard",
    "version": 1,
    "system": "You are an expert programming assistant. Use ONLY the Python standard library (no external dependencies) and return the code inside a ```python block. Handle every edge case described.",
    "prompt": "Implement `summarize_ranges(nums)`. It receives a list of integers sorted in non-decreasing order, POSSIBLY WITH DUPLICATES, and returns a list of strings describing the consecutive runs: a run of a single value is \"5\", and a longer run is \"1->3\". Duplicates do not break a run. Negative numbers are allowed. An empty list returns an empty list. Example: summarize_ranges([0,1,2,4,5,7]) -> ['0->2','4->5','7'].",
    "target_tokens": 640,
    "reference": "Walk the list tracking the start of the run; skip duplicates; a run closes when the next value is neither equal nor the successor.",
    "code_tests": [
      "assert list(summarize_ranges([0,1,2,4,5,7])) == ['0->2','4->5','7']",
      "assert list(summarize_ranges([])) == []",
      "assert list(summarize_ranges([5])) == ['5']",
      "assert list(summarize_ranges([1,1,2,3,3,7])) == ['1->3','7']",
      "assert list(summarize_ranges([-3,-2,-1,1])) == ['-3->-1','1']",
      "assert list(summarize_ranges([1,3,5])) == ['1','3','5']",
      "assert list(summarize_ranges([2,2,2])) == ['2']",
      "assert list(summarize_ranges([-1,0,0,1,5,6])) == ['-1->1','5->6']"
    ]
  },
