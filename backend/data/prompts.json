  {
    "id": "reasoning",
    "name": "Logical reasoning",
    "type": "reasoning",
    "difficulty": "medium",
    "version": 2,
    "system": "You are an assistant that reasons step by step. Be concise but rigorous. ALWAYS end with a single final line in exactly this format, with no other text on it: 'Result: Ana=X, Bea=Y, Carlos=Z, Dana=W' (amounts in euros, digits only).",
    "prompt": "Four flatmates share a 2450€ monthly rent. Bea pays 200€ more than Ana. Carlos pays twice what Ana pays. Dana pays 150€ less than Carlos. How much does each one pay? Reason briefly, check that the four amounts add up to the rent, and give the final result line.",
    "target_tokens": 512,
    "reference": "Ana pays 400€, Bea 600€, Carlos 800€ and Dana 650€. Total 2450€.",
    "checks": [
      {
        "kind": "number",
        "value": "400",
        "near": [
          "ana"
        ],
        "weight": 2,
        "label": "Ana = 400"
      },
      {
        "kind": "number",
        "value": "600",
        "near": [
          "bea"
        ],
        "weight": 2,
        "label": "Bea = 600"
      },
      {
        "kind": "number",
        "value": "800",
        "near": [
          "carlos"
        ],
        "weight": 2,
        "label": "Carlos = 800"
      },
      {
        "kind": "number",
        "value": "650",
        "near": [
          "dana"
        ],
        "weight": 2,
        "label": "Dana = 650"
      },
      {
        "kind": "number",
        "value": "2450",
        "label": "checks the total (2450)"
      },
      {
        "kind": "absent",
        "of": [
          "612.5",
          "612",
          "6125"
        ],
        "weight": 2,
        "label": "does not fall for the equal-split trap"
      },
      {
        "kind": "regex",
        "pattern": "result:\\s*ana\\s*=\\s*400\\s*,\\s*bea\\s*=\\s*600\\s*,\\s*carlos\\s*=\\s*800\\s*,\\s*dana\\s*=\\s*650",
        "weight": 3,
        "label": "exact final result line"
      }
    ]
  },
  {
    "id": "logic",
    "name": "Deduction puzzle",
    "type": "reasoning",
    "difficulty": "hard",
    "version": 1,
    "system": "You are a rigorous logic solver. Think it through, then end your answer with exactly four lines, one per position, in the form 'N: Name' (N from 1 to 4, 1 = winner). No other text after those lines.",
    "prompt": "Four runners finished a race: Dana, Elena, Farid and Gus. Farid finished immediately after Dana. Elena did not finish last. Gus finished before Elena. There are no ties. Work out the finishing order.",
    "target_tokens": 512,
    "reference": "1 Gus, 2 Elena, 3 Dana, 4 Farid.",
    "checks": [
      {
        "kind": "regex",
        "pattern": "^\\s*1\\s*[:.)\\-]\\s*gus\\b",
        "weight": 2,
        "label": "1st = Gus"
      },
      {
        "kind": "regex",
        "pattern": "^\\s*2\\s*[:.)\\-]\\s*elena\\b",
        "weight": 2,
        "label": "2nd = Elena"
      },
      {
        "kind": "regex",
        "pattern": "^\\s*3\\s*[:.)\\-]\\s*dana\\b",
        "weight": 2,
        "label": "3rd = Dana"
      },
      {
        "kind": "regex",
        "pattern": "^\\s*4\\s*[:.)\\-]\\s*farid\\b",
        "weight": 2,
        "label": "4th = Farid"
      },
      {
        "kind": "absent",
        "pattern": "^\\s*1\\s*[:.)\\-]\\s*dana\\b",
        "label": "does not start the order with Dana (the tempting wrong read)"
      },
      {
        "kind": "absent",
        "pattern": "^\\s*5\\s*[:.)\\-]",
        "label": "does not invent a fifth position"
      }
    ]
  },
