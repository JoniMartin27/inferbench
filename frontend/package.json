{
  "name": "inferbench-frontend",
  "productName": "InferBench",
  "version": "0.3.0",
  "private": true,
  "description": "InferBench desktop UI (Electron + React)",
  "author": "Jonathan Martin",
  "repository": {
    "type": "git",
    "url": "https://github.com/JoniMartin27/inferbench.git"
  },
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:unit": "node --test src/lib/exportResults.test.js",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.2.5",
    "electron": "^42.11.15",
    "electron-builder": "^26.17.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "vite": "^8.3.4",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.inferbench.app",
    "productName": "InferBench",
    "electronVersion": "42.11.15",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/sidecar/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/sidecar/",
        "to": "sidecar/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "InferBench",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Development",
      "desktop": {
        "entry": {
          "Name": "InferBench",
          "Comment": "Descarga, arranca y benchmarkea motores de inferencia LLM locales",
          "Categories": "Development;Utility;"
        }
      }
    }
  }
}
